# Required
EXA_API_KEY=              # https://dashboard.exa.ai  (free credits on signup)
GROQ_API_KEYS=            # https://console.groq.com/keys  one key, or several comma-separated (used in rotation)

# Optional
# MODEL=openai/gpt-oss-120b
# FALLBACK_MODEL=openai/gpt-oss-20b   # used when every key is rate limited on MODEL (limits are per model)
# REASONING_EFFORT=low    # low | medium | high  (gpt-oss models only)
# EXA_SEARCH_TYPE=auto    # auto | lite (faster, cached)
# PORT=3000
# DB_PATH=data/minimi.db
# DEFAULT_TZ=Asia/Kolkata # used when the browser doesn't send one
# NOW=2026-11-03T10:00:00+05:30   # fake clock for demos (time keeps moving from here)
