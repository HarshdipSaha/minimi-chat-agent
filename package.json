{
  "name": "minimi-chat-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A chat agent with one tool (web search) that answers fast, cites dated sources, and remembers what you asked and when.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --disable-warning=ExperimentalWarning src/main.ts",
    "start": "tsx --disable-warning=ExperimentalWarning src/main.ts",
    "test": "tsx --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "seed": "tsx --disable-warning=ExperimentalWarning scripts/seed.ts load",
    "seed:record": "tsx --disable-warning=ExperimentalWarning scripts/seed.ts record",
    "eval": "tsx --disable-warning=ExperimentalWarning evals/run.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "chrono-node": "^2.10.3",
    "hono": "^4.13.17",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
